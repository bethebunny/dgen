from builtin import Effect, Handler, Linear, Nil, Pointer, Tuple
from index import Index
import function

# State is the effect tag for memory access. Origins handle it: each
# access consumes an origin and produces a fresh one, so accesses to
# the same region form a use-def thread. See docs/origins.md.
type State:
    data: Nil
    has trait Effect

# Zero-sized evidence for a region of memory. Erased at codegen.
# destructor is the function destroy applies to the origin, set by
# attach. The default Nil means destroy has no runtime action.
type Origin<destructor: function.Function = Nil>:
    data: Nil
    has trait Linear
    has trait Handler<State>

# Pointer to a single cell. Access requires the region's origin.
type Reference<element_type: Type>:
    data: Pointer<element_type>

# Pointer to a count-element backing store, shared across many ops.
# Accesses are ordered by a mem operand instead of an origin.
type Buffer<element_type: Type>:
    data: Pointer<Nil>

# load returns Tuple<[element_type, Origin]>.
op stack_allocate<element_type: Type>() -> Tuple<[Reference<element_type>, Origin]>
op heap_allocate<element_type: Type>() -> Tuple<[Reference<element_type>, Origin]>
op load(origin: Origin, ref: Reference)
op store(origin: Origin, ref: Reference, value: Type) -> Origin
op destroy(origin: Origin) -> Nil

# Consume an origin, return one whose type carries the destructor.
# The result is annotated Origin<destructor>; ops that thread the
# origin (store, load) annotate their results with the same type.
op attach(origin: Origin, destructor: function.Function)

# Frees the reference. The primitive a heap destructor's body calls;
# frontends use destroy.
op deallocate(origin: Origin, ref: Reference) -> Nil

# The mem operand is the previous operation on the buffer.
op buffer_allocate<element_type: Type>(count: Index) -> Buffer<element_type>
op buffer_stack_allocate<element_type: Type>(count: Index) -> Buffer<element_type>
op buffer_load(mem, buf: Buffer, index: Index)
op buffer_store(mem, buf: Buffer, index: Index, value: Type) -> Nil
op buffer_deallocate(mem, buf: Buffer) -> Nil
