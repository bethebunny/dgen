from index import Index

trait Effect
trait Handler<effect_type: Type>

# Linear / Affine: marker traits for resource discipline. A value is
# Linear iff it must be consumed exactly once, Affine iff it may be
# consumed at most once. See docs/linear_types.md.
trait Linear
trait Affine

# Block-execution contracts: how a block-holding op runs its owned
# blocks, declared so the linearity verifier can charge linear captures
# precisely (see docs/linear_types.md and Op.verify_block_linearity).
# A block-holding op whose execution multiplicity is *intrinsic* (fixed
# by the op's own semantics) should declare exactly one of these, or
# override Op.verify_block_linearity with its own implementation. Ops
# that do neither are verified conservatively — which is the honest
# treatment for the goto family, whose bodies' multiplicity is
# *extrinsic*: determined by the branch graph around a label, not by
# the label op itself.
#
# - ExactlyOnce:      every owned block runs exactly once per execution.
# - Alternatives:     exactly one owned block runs, and the blocks never
#                     transfer control into each other.
# - BodyWithHandler:  a body block that always starts plus a handler
#                     block that runs iff the body diverges into it.
# - ZeroOrMore:       owned blocks run zero or more times per execution
#                     (loops). A linear value can never be soundly
#                     captured into such a block (zero runs leak it, two
#                     runs double-consume it) — it must be threaded as a
#                     loop carry instead. Carry threading needs the
#                     carry-pair rule (see TODO.md); until then the
#                     contract's whole content is rejecting linear
#                     captures.
trait ExactlyOnce
trait Alternatives
trait BodyWithHandler
trait ZeroOrMore

type Nil:
    layout Void

type Never:
    layout Void

# Diverge is the umbrella effect for non-returning control transfer:
# any effect whose handler invocation may not return falls under it.
# Other diverging effects (Raise, branch-via-Label, ...) declare
# themselves as Diverge so a single `Handler<Diverge>` query suffices to
# detect potentially-divergent ops. See docs/control-flow.md.
type Diverge:
    data: Nil
    has trait Effect

type String:
    layout String

type TypeTag:
    storage: String

type Byte:
    layout Byte

type Array<element_type: Type, n: Index>:
    layout Array

type Pointer<pointee: Type>:
    layout Pointer

type Span<pointee: Type>:
    layout Span

type Tuple<types: Span<Type>>:
    layout Record

op chain(lhs, rhs)
op type(value) -> Type
op extern<symbol: String>()
op unpack(tuple):
    block body
    has trait ExactlyOnce
