from index import Index

trait Effect
trait Handler<effect_type: Type>

# Linear / Affine: marker traits for resource discipline. A value is
# Linear iff it must be consumed exactly once, Affine iff it may be
# consumed at most once. See docs/linear_types.md.
trait Linear
trait Affine

# Block-execution traits declare how a block-holding op runs its owned
# blocks, so the linearity verifier can charge linear captures at the
# parent. See docs/linear_types.md and Op.verify_block_linearity. Every
# block-holding op must declare exactly one of these traits or override
# Op.verify_block_linearity with its own implementation. An op that
# does neither fails verification.
#
# - ExactlyOnce runs every owned block exactly once per execution.
# - Alternatives runs exactly one owned block. The blocks never
#   transfer control into each other.
# - BodyWithHandler has a body block that always starts and a handler
#   block that runs iff the body diverges into it.
# - ZeroOrMore runs its owned blocks zero or more times (loops and
#   function bodies). No consumption count is sound for a linear
#   capture into such a block. Zero runs leak it and two runs
#   double-consume it, so linear captures are rejected. A linear value
#   must be threaded as a loop carry instead, which awaits the
#   carry-pair rule in TODO.md.
# - ExtrinsicBlocks marks ops whose block multiplicity is not a
#   property of the op at all. The branch graph around a goto label
#   determines how often its body runs. Captures verify
#   conservatively. The precision lives at the structured level that
#   lowered here.
trait ExactlyOnce
trait Alternatives
trait BodyWithHandler
trait ZeroOrMore
trait ExtrinsicBlocks

type Nil:
    layout Void

type Never:
    layout Void

# Diverge is the umbrella effect for non-returning control transfer:
# any effect whose handler invocation may not return falls under it.
# Other diverging effects (Raise, branch-via-Label, ...) declare
# themselves as Diverge so a single `Handler<Diverge>` query suffices to
# detect potentially-divergent ops. See docs/control-flow.md.
type Diverge:
    data: Nil
    has trait Effect

type String:
    layout String

type TypeTag:
    storage: String

type Byte:
    layout Byte

type Array<element_type: Type, n: Index>:
    layout Array

type Pointer<pointee: Type>:
    layout Pointer

type Span<pointee: Type>:
    layout Span

type Tuple<types: Span<Type>>:
    layout Record

op chain(lhs, rhs)
op type(value) -> Type
op extern<symbol: String>()
op unpack(tuple):
    block body
    has trait ExactlyOnce
