// Definitions every ODS file generated by `python -m dgen.gen --target mlir` uses.
// Hand-written: the generator includes it and never writes it.

#ifndef DGEN_TD
#define DGEN_TD

include "mlir/IR/OpBase.td"
include "mlir/IR/AttrTypeBase.td"

def Dgen_Dialect : Dialect {
  let name = "dgen";
  let cppNamespace = "::dgen";
  let summary = "What every dialect generated by dgen shares";
  let useDefaultTypePrinterParser = 1;
}

// The type of type values, eg. the result of builtin.type.
def Dgen_Type : TypeDef<Dgen_Dialect, "Type"> {
  let mnemonic = "Type";
  let summary = "the type of a type value";
}

// A dgen block has no terminator and names its result. Its region ends with this.
def Dgen_YieldOp : Op<Dgen_Dialect, "yield", [Terminator]> {
  let summary = "the result of a dgen block";
  let arguments = (ins AnyType:$value);
}

// A compile-time value of a dgen type: a typed attribute whose type satisfies `type`.
class Dgen_ValueAttr<Type type> : Attr<
    And<[CPred<"::llvm::isa<::mlir::TypedAttr>($_self)">,
         SubstLeaves<"$_self", "::llvm::cast<::mlir::TypedAttr>($_self).getType()",
                     type.predicate>]>,
    "a compile-time " # type.summary # " value"> {
  let storageType = "::mlir::TypedAttr";
  let returnType = "::mlir::TypedAttr";
  let convertFromStorage = "$_self";
}

#endif // DGEN_TD
