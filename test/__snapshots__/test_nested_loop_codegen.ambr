# serializer version: 1
# name: test_for_multi_carry_llvm_ir
  '''
  
  define void @main() {
  entry:
    br label %loop_header
  loop_header:
    %_0 = phi { i64, i64, i64 } [ { i64 0, i64 1, i64 2 }, %entry ], [ %_1, %loop_body ]
    %i = extractvalue { i64, i64, i64 } %_0, 0
    %a = extractvalue { i64, i64, i64 } %_0, 1
    %b = extractvalue { i64, i64, i64 } %_0, 2
    br label %loop_body_exit
  loop_body:
    %_2 = phi { i64, i64, i64 } [ %_3, %loop_body_exit ]
    %i4 = extractvalue { i64, i64, i64 } %_2, 0
    %a5 = extractvalue { i64, i64, i64 } %_2, 1
    %b6 = extractvalue { i64, i64, i64 } %_2, 2
    %_7 = add i64 %i4, 1
    %_8 = add i64 %a5, %b6
    %_9 = insertvalue { i64, i64, i64 } undef, i64 %_7, 0
    %_10 = insertvalue { i64, i64, i64 } %_9, i64 %b6, 1
    %_1 = insertvalue { i64, i64, i64 } %_10, i64 %_8, 2
    br label %loop_header
  loop_body_exit:
    %_11 = icmp slt i64 %i, 3
    %_12 = insertvalue { i64, i64, i64 } undef, i64 %i, 0
    %_13 = insertvalue { i64, i64, i64 } %_12, i64 %a, 1
    %_3 = insertvalue { i64, i64, i64 } %_13, i64 %b, 2
    br i1 %_11, label %loop_body, label %exit
  exit:
    ret void
  }
  '''
# ---
# name: test_nested_loop_llvm_ir
  '''
  
  define void @main() {
  entry:
    br label %loop_header
  loop_header:
    %_3 = phi { i64 } [ { i64 0 }, %entry ], [ %_4, %exit ]
    %i = extractvalue { i64 } %_3, 0
    br label %loop_body_exit
  loop_body:
    %_5 = phi { i64 } [ %_6, %loop_body_exit ]
    %i7 = extractvalue { i64 } %_5, 0
    %_8 = add i64 %i7, 1
    br label %loop_header0
  loop_header0:
    %_9 = phi { i64 } [ { i64 0 }, %loop_body ], [ %_10, %loop_body1 ]
    %i11 = extractvalue { i64 } %_9, 0
    br label %loop_body1_exit
  loop_body1:
    %_12 = phi { i64 } [ %_13, %loop_body1_exit ]
    %j = extractvalue { i64 } %_12, 0
    %_14 = add i64 %j, 1
    %_10 = insertvalue { i64 } undef, i64 %_14, 0
    br label %loop_header0
  loop_body1_exit:
    %_15 = icmp slt i64 %i11, 2
    %_13 = insertvalue { i64 } undef, i64 %i11, 0
    br i1 %_15, label %loop_body1, label %exit
  exit:
    %_4 = insertvalue { i64 } undef, i64 %_8, 0
    br label %loop_header
  loop_body_exit:
    %_16 = icmp slt i64 %i, 2
    %_6 = insertvalue { i64 } undef, i64 %i, 0
    br i1 %_16, label %loop_body, label %exit2
  exit2:
    ret void
  }
  '''
# ---
