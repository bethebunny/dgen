import dcc
import function
import index
import memory
import number

%f : function.Function<[], Nil> = function.function<Nil>() body():
    %0 : dcc.CStruct<"S", "S", "S"> = 0
    %1 : dcc.CStruct<"S", "S", "S"> = dcc.variable_declaration<"s", dcc.CStruct<"S", "S", "S">>(%0)
    %2 : memory.Reference<dcc.CStruct<"S", "S", "S">> = dcc.address_of(%1)
    %3 : memory.Reference<number.SignedInteger<32>> = dcc.field_address<"x">(%2)
    %4 : number.SignedInteger<32> = 7
    %5 : number.SignedInteger<32> = dcc.store_indirect(%3, %4)
