import dcc
import function
import index
import memory
import number

%f : function.Function<[memory.Reference<dcc.CStruct<"S", "S", "S">>], Nil> = function.function<Nil>() body(%s: memory.Reference<dcc.CStruct<"S", "S", "S">>):
    %0 : memory.Reference<number.SignedInteger<32>> = dcc.field_address<"x">(%s)
    %1 : number.SignedInteger<32> = 7
    %2 : number.SignedInteger<32> = dcc.store_indirect(%0, %1)
