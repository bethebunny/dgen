from builtin import Nil, ZeroOrMore
from index import Index

# Actor and pipeline bodies run once per message, which is zero or
# more times per execution of the op.
op actor<consume_rate: Index, produce_rate: Index>(input) -> Nil:
    block body
    has trait ZeroOrMore

op produce(value) -> Nil

op pipeline(input):
    block body
    has trait ZeroOrMore
